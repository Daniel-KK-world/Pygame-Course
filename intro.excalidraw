    {
      "id": "OaPI96P4pL-wVPQbpzdCr",
      "type": "text",
      "x": 795,
      "y": -204,
      "width": 305.78387451171875,
      "height": 45,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 2017865690,
      "version": 111,
      "versionNonce": 320527962,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791286542926,
      "link": null,
      "locked": false,
      "text": "What is Pygame? ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is Pygame? ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "bs2ovVKLA5lIIXE6ZpSqZ",
      "type": "text",
      "x": 1011,
      "y": -71,
      "width": 650.85986328125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 1290621830,
      "version": 192,
      "versionNonce": 2048125254,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791286835706,
      "link": null,
      "locked": false,
      "text": "so pygame is giving python \"access\" to the OS, \nthings like the keyboard, graphics, input and \noutput, sound, time etc... \n\nso pygame itself is not an engine.   ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "so pygame is giving python \"access\" to the OS, \nthings like the keyboard, graphics, input and \noutput, sound, time etc... \n\nso pygame itself is not an engine.   ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1-ddNZFbx7NR_S16_vHr2",
      "type": "text",
      "x": 1021,
      "y": 150,
      "width": 759.1077270507812,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 772711494,
      "version": 275,
      "versionNonce": 743751366,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791287004387,
      "link": null,
      "locked": false,
      "text": "so if you want to move past platformers and build \nmore complex stuff you'll need a dedicated engine not \njust an interface cos with pygame you are still doing all\nthe heavy lifting. ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "so if you want to move past platformers and build \nmore complex stuff you'll need a dedicated engine not \njust an interface cos with pygame you are still doing all\nthe heavy lifting. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
